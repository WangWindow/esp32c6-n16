[
  {
    "label": "probe-rs Debug (app)",
    "adapter": "probe-rs",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",
    "chip": "esp32c6",
    "flashingConfig": {
      "flashingEnabled": true
    },
    "coreConfigs": [
      {
        "coreIndex": 0,
        "programBinary": "target/riscv32imac-unknown-none-elf/release/esp32c6-n16-app",
        "rttEnabled": true
      }
    ],
    "build": {
      "command": "cargo build --release"
    }
  }
]
